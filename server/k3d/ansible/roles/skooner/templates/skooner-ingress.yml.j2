---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: skooner
  namespace: kube-system
  annotations:
    kubernetes.io/ingress.class: traefik
spec:
  tls:
    - hosts:
        - vsfdmd.ovh
      secretName: domain-tls
  rules:
    - host: {{ inventory_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: skooner
                port:
                  number: 80
    - host: vsfdmd.ovh
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: skooner
                port:
                  number: 80
---
apiVersion: traefik.io/v1alpha1
kind: ServersTransport
metadata:
  name: gateway-skipverify
  namespace: kube-system
spec:
  insecureSkipVerify: true
---
apiVersion: v1
kind: Endpoints
metadata:
  name: gateway-external
  namespace: kube-system
subsets:
  - addresses:
      - ip: 192.168.0.1
    ports:
      - port: 443
---
apiVersion: v1
kind: Service
metadata:
  name: gateway-external
  namespace: kube-system
  annotations:
    traefik.ingress.kubernetes.io/service.serversscheme: https
    traefik.ingress.kubernetes.io/service.serverstransport: kube-system-gateway-skipverify@kubernetescrd
spec:
  ports:
    - port: 443
      targetPort: 443
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: gateway
  namespace: kube-system
  annotations:
    kubernetes.io/ingress.class: traefik
spec:
  tls:
    - hosts:
        - gateway.vsfdmd.ovh
      secretName: domain-tls
  rules:
    - host: gateway.vsfdmd.ovh
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: gateway-external
                port:
                  number: 443
