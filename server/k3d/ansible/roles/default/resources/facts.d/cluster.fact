#!/bin/bash
# Cluster is created as inventory_hostname (often FQDN like k3d0.iot).
# hostname -s alone misses that; probe all aliases from hostname -A.
SHORT="$(hostname -s)"
NAME=""
EXISTS="false"
for candidate in $(hostname -A 2>/dev/null) "${SHORT}"; do
    [[ -z "${candidate}" ]] && continue
    if k3d cluster list "${candidate}" >/dev/null 2>&1; then
        NAME="${candidate}"
        EXISTS="true"
        break
    fi
done
if [[ -z "${NAME}" ]]; then
    NAME="$(hostname -A 2>/dev/null | awk '{print $1}')"
    [[ -z "${NAME}" ]] && NAME="${SHORT}"
fi

REGISTRY="$(k3d registry list registry.localhost 2>/dev/null | tail -n +2 | cut -d" " -f1)"

echo "{
    \"exists\": $EXISTS,
    \"name\": \"$NAME\",
    \"registry\": \"$REGISTRY\"
}"
