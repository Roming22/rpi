#!/bin/bash
# Cluster is created as inventory_hostname (often FQDN like k3d0.iot).
# Ansible writes that name to /var/ansible/cluster_name before setup.
NAME=""
if [[ -f /var/ansible/cluster_name ]]; then
    NAME="$(tr -d '[:space:]' </var/ansible/cluster_name)"
fi
if [[ -z "${NAME}" ]]; then
    NAME="$(hostname -s)"
fi

EXISTS="false"
if [[ -n "${NAME}" ]] && k3d cluster list "${NAME}" >/dev/null 2>&1; then
    EXISTS="true"
fi

REGISTRY=""
if docker inspect k3d-registry.localhost >/dev/null 2>&1; then
    REGISTRY="k3d-registry.localhost"
fi

echo "{
    \"exists\": $EXISTS,
    \"name\": \"$NAME\",
    \"registry\": \"$REGISTRY\"
}"
